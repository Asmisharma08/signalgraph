# SignalGraph — Backend Environment Variables Example
# Copy this file to .env and fill in your own Supabase project's values.
# Never commit the real .env file — these are placeholders only.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

FRONTEND_ORIGIN=http://localhost:5173
REPLAY_MODE=true
POLL_INTERVAL_SECONDS=30

# Optional — enables Claude-powered chat/market-brief responses.
# Leave unset to use the fully deterministic, zero-cost fallback paths.
ANTHROPIC_API_KEY=
AI_BRIEF_ENABLED=true
